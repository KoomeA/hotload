HOTLOAD_REDIS_URL=redis://redis:6379/0
HOTLOAD_DATA_DIR=/data
HOTLOAD_FILE_TTL_SECONDS=3600
HOTLOAD_MAX_DURATION_SECONDS=1200
HOTLOAD_RATE_LIMIT_PER_MINUTE=20
HOTLOAD_REQUIRE_AGE_GATE=true
# HOTLOAD_PROXY_URL=http://user:pass@proxy:8080
# HOTLOAD_BLOCKED_HOSTS=["example.invalid"]

# --- Reliability (M1) ---
# Rotating upstream proxies (JSON list) and per-site routes ("direct" = no proxy):
# HOTLOAD_PROXY_URLS=["http://user:pass@p1:8080","http://user:pass@p2:8080"]
# HOTLOAD_PROXY_ROUTES={"youtube.com":["http://user:pass@p1:8080"],"archive.org":["direct"]}
HOTLOAD_MAX_ATTEMPTS=3
HOTLOAD_CANARY_ENABLED=true
# HOTLOAD_CANARY_FILE=/config/canaries.json   # replaces the built-in list (add adult-site canaries here)
# HOTLOAD_METRICS_TOKEN=change-me             # require "Authorization: Bearer ..." on /metrics
# HOTLOAD_TRUST_PROXY_HEADERS=true            # behind a reverse proxy
