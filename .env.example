HOTLOAD_REDIS_URL=redis://redis:6379/0
HOTLOAD_DATA_DIR=/data
HOTLOAD_FILE_TTL_SECONDS=3600
HOTLOAD_MAX_DURATION_SECONDS=1200
HOTLOAD_RATE_LIMIT_PER_MINUTE=20
HOTLOAD_REQUIRE_AGE_GATE=true
# HOTLOAD_PROXY_URL=http://user:pass@proxy:8080
# HOTLOAD_BLOCKED_HOSTS=["example.invalid"]

# --- Reliability (M1) ---
# Rotating upstream proxies (JSON list) and per-site routes ("direct" = no proxy):
# HOTLOAD_PROXY_URLS=["http://user:pass@p1:8080","http://user:pass@p2:8080"]
# HOTLOAD_PROXY_ROUTES={"youtube.com":["http://user:pass@p1:8080"],"archive.org":["direct"]}
HOTLOAD_MAX_ATTEMPTS=3
HOTLOAD_CANARY_ENABLED=true
# HOTLOAD_CANARY_FILE=/config/canaries.json   # replaces the built-in list (add adult-site canaries here)
# HOTLOAD_METRICS_TOKEN=change-me             # require "Authorization: Bearer ..." on /metrics
# HOTLOAD_TRUST_PROXY_HEADERS=true            # behind a reverse proxy

# --- Accounts and plans (M2) ---
# Required for the hosted service: a long random value (openssl rand -hex 32). Without it sessions reset on restart.
# HOTLOAD_SECRET_KEY=
# HOTLOAD_PUBLIC_URL=https://hotload.example
# HOTLOAD_COOKIE_SECURE=true
# HOTLOAD_DATABASE_URL=postgresql+asyncpg://user:pass@db/hotload   # default: SQLite in the data dir
# HOTLOAD_QUOTAS_ENABLED=false        # true enforces plan limits; self-host default is unlimited
# HOTLOAD_REGISTRATION_OPEN=true
# Discord bot (interactions webhook; docs/BOTS.md)
# HOTLOAD_DISCORD_PUBLIC_KEY=  HOTLOAD_DISCORD_APPLICATION_ID=
# HOTLOAD_DISCORD_BOT_TOKEN=   # only for `python -m hotload.admin discord-commands`; unset it afterwards
# HOTLOAD_DISCORD_ALLOWED_USERS=[]
# Email verification and password reset (all three of host, sender and PUBLIC_URL are needed to turn it on)
# HOTLOAD_SMTP_HOST=smtp.example
# HOTLOAD_SMTP_PORT=587
# HOTLOAD_SMTP_SECURITY=starttls                 # starttls | ssl | none (none only for a local relay)
# HOTLOAD_SMTP_USER= / HOTLOAD_SMTP_PASSWORD=
# HOTLOAD_MAIL_FROM="Hotload <no-reply@your.domain>"
# HOTLOAD_REQUIRE_VERIFIED_EMAIL=false           # true: unconfirmed accounts cannot buy plans or create API keys
# HOTLOAD_GITHUB_CLIENT_ID= / HOTLOAD_GITHUB_CLIENT_SECRET=
# HOTLOAD_GOOGLE_CLIENT_ID= / HOTLOAD_GOOGLE_CLIENT_SECRET=

# --- Billing (M3). Read docs/PAYMENTS.md first: Paystack's policy bars adult content and copyright-infringing items. ---
# HOTLOAD_PAYSTACK_SECRET_KEY=sk_live_...       # also set the webhook URL in the Paystack dashboard:
#                                               #   <PUBLIC_URL>/api/v1/billing/webhooks/paystack
# HOTLOAD_BTCPAY_URL=https://btcpay.example.com
# HOTLOAD_BTCPAY_STORE_ID=...
# HOTLOAD_BTCPAY_API_KEY=...                    # needs btcpay.store.cancreateinvoice and btcpay.store.canviewinvoices
# HOTLOAD_BTCPAY_WEBHOOK_SECRET=...             # webhook URL: <PUBLIC_URL>/api/v1/billing/webhooks/btcpay
# HOTLOAD_PRICES={"KES":{"premium_30":129900,"premium_365":1079900,"pro_30":389900,"pro_365":3079900}}  # minor units; your own prices

# --- Object storage (S3, Cloudflare R2, MinIO). Default is local disk. ---
# HOTLOAD_STORAGE_BACKEND=s3
# HOTLOAD_S3_BUCKET=hotload-files
# HOTLOAD_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# HOTLOAD_S3_REGION=auto
# HOTLOAD_S3_ACCESS_KEY_ID=...
# HOTLOAD_S3_SECRET_ACCESS_KEY=...
# HOTLOAD_WORKER_QUEUE=hotload:priority         # set on the priority worker pool only

# --- API ---
# HOTLOAD_API_RATE_LIMIT_PER_MINUTE=120

# --- M4 extras ---
# HOTLOAD_COOKIE_KEY=...                        # enables saved cookies; make one with: python -m hotload.admin cookie-key
# HOTLOAD_MAX_LIVE_MINUTES=60                   # longest live recording a job may request (self-host cap)
# HOTLOAD_TELEGRAM_BOT_TOKEN=123456:...         # see docs/BOTS.md; also needs HOTLOAD_PUBLIC_URL (public HTTPS)
# HOTLOAD_TELEGRAM_WEBHOOK_SECRET=a-long-random-string
# HOTLOAD_TELEGRAM_ALLOWED_CHATS=[123456789]    # empty = anyone
